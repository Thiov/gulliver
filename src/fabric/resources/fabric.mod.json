{
  "schemaVersion": 1,
  "id": "gulliver",
  "version": "${mod_version}",
  "name": "Gulliver",
  "description": "Resize yourself or other entities from 0.125x to 8x. Movement, combat, reach, sound, and world interaction all scale with size. Inspired by UncleMion's classic Gulliver mod.",
  "icon": "assets/gulliver/icon.png",
  "authors": ["Thiov"],
  "contact": {
    "sources": "https://github.com/Thiov/gulliver-fabric",
    "issues": "https://github.com/Thiov/gulliver-fabric/issues"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["gulliver.fabric.GulliverFabric"],
    "client": ["gulliver.fabric.GulliverFabricClient"]
  },
  "mixins": [
    "gulliver.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "${fabric_api_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
